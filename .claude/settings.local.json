{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(npm run build:*)",
      "Bash(python -m py_compile:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/credentials/**)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)"
    ]
  }
}
